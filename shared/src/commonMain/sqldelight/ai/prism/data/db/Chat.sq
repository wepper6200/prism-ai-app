-- Диалоги и сообщения Prism AI.

CREATE TABLE chat (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- Папка проекта диалога (путь на Desktop, URI дерева документов на Android) или NULL.
    workspace TEXT,
    -- Краткое содержание начала длинного диалога и последнее сообщение, которое оно охватывает.
    summary TEXT,
    summary_until TEXT
);

CREATE TABLE message (
    id TEXT NOT NULL PRIMARY KEY,
    chat_id TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    status TEXT NOT NULL,
    error TEXT,
    model_id TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX message_by_chat ON message(chat_id, created_at);

selectChats:
SELECT * FROM chat ORDER BY updated_at DESC;

insertChat:
INSERT INTO chat(id, title, created_at, updated_at) VALUES (?, ?, ?, ?);

setTitleIfEmpty:
UPDATE chat SET title = ? WHERE id = ? AND title IS NULL;

selectWorkspace:
SELECT workspace FROM chat WHERE id = ?;

setWorkspace:
UPDATE chat SET workspace = ? WHERE id = ?;

selectSummary:
SELECT summary, summary_until FROM chat WHERE id = ?;

setSummary:
UPDATE chat SET summary = ?, summary_until = ? WHERE id = ?;

touchChat:
UPDATE chat SET updated_at = ? WHERE id = ?;

deleteChat:
DELETE FROM chat WHERE id = ?;

deleteMessagesOfChat:
DELETE FROM message WHERE chat_id = ?;

selectMessages:
SELECT * FROM message WHERE chat_id = ? ORDER BY created_at, rowid;

insertMessage:
INSERT INTO message(id, chat_id, role, content, status, error, model_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateMessage:
UPDATE message SET content = ?, status = ?, error = ? WHERE id = ?;

deleteMessage:
DELETE FROM message WHERE id = ?;

markInterrupted:
UPDATE message SET status = 'FAILED', error = 'INTERRUPTED' WHERE status = 'GENERATING';
