-- Шаги ассистента с инструментами (поиск, страницы, файлы, команды) под ответом.

CREATE TABLE message_step (
    message_id TEXT NOT NULL,
    chat_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    tool TEXT NOT NULL,
    title TEXT NOT NULL,
    detail TEXT NOT NULL,
    status TEXT NOT NULL,
    PRIMARY KEY (message_id, position)
);

CREATE INDEX message_step_by_chat ON message_step(chat_id);

insertStep:
INSERT OR REPLACE INTO message_step(message_id, chat_id, position, tool, title, detail, status) VALUES (?, ?, ?, ?, ?, ?, ?);

selectStepsOfChat:
SELECT * FROM message_step WHERE chat_id = ? ORDER BY message_id, position;

deleteStepsOfMessage:
DELETE FROM message_step WHERE message_id = ?;

deleteStepsOfChat:
DELETE FROM message_step WHERE chat_id = ?;
